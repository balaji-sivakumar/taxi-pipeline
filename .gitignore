__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.idea/

# data files are preserved on disk, not in git history
data/raw/*
!data/raw/.gitkeep
data/rejected/*
!data/rejected/.gitkeep
data/curated/*
!data/curated/.gitkeep

# manifest.json's claims are only valid relative to local raw/curated files,
# which are themselves gitignored -- committing it alone would let a fresh
# clone show months as "processed" with no underlying data to back that up.
data/manifest.json
